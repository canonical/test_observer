{
  "name": "test-observer-sveltekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node --test tests/*.test.js",
    "lint": "svelte-kit sync && prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "happy-dom": "^21.0.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@canonical/launchpad-design-tokens": "^1.1.1",
    "@canonical/svelte-ds-app-launchpad": "^0.33.0",
    "@canonical/svelte-icons": "^0.0.9",
    "@svgrid/grid": "^3.0.6",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1"
  }
}
