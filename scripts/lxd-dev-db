"""Set up or refresh the shared PostgreSQL container for LXD development."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def main() -> None:
    lxd_dev = Path(__file__).resolve().with_name("lxd-dev")
    os.execv(sys.executable, [sys.executable, str(lxd_dev), "db-setup", *sys.argv[1:]])


if __name__ == "__main__":
    main()
