DATABASE_STATE_FILE = STATE_DIR / "database-state.json"
SYSTEM_DIR = Path("/opt/test-observer-lxd-dev")
SYSTEM_STATE_DIR = Path("/var/lib/test-observer-lxd-dev")
WEBROOT = SYSTEM_STATE_DIR / "www"
