def progress(message: str) -> None:
    print(f"==> {message}", file=sys.stderr, flush=True)


def fail(message: str, status: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(status)


def run(
    args: list[str],
    *,
    capture: bool = False,
    input_text: str | None = None,
    check: bool = True,
    env: dict[str, str] | None = None,
    cwd: Path | str | None = None,
    stdout: int | None = None,
) -> subprocess.CompletedProcess[str]:
    kwargs: dict[str, object] = {"text": True, "env": env}
    if cwd is not None:
        kwargs["cwd"] = cwd
    if capture:
        kwargs["stdout"] = subprocess.PIPE
        kwargs["stderr"] = subprocess.STDOUT
    elif stdout is not None:
        kwargs["stdout"] = stdout
    if input_text is not None:
        kwargs["input"] = input_text
    result = subprocess.run(args, **kwargs)  # type: ignore[arg-type]
    if check and result.returncode:
        output = result.stdout or "" if capture else ""
        if output:
            print(output, file=sys.stderr, end="")
        raise subprocess.CalledProcessError(result.returncode, args)
    return result


def sudo(args: list[str], **kwargs: object) -> subprocess.CompletedProcess[str]:
    if os.geteuid() == 0:
        return run(args, **kwargs)  # type: ignore[arg-type]
    return run(["sudo", "-n", *args], **kwargs)  # type: ignore[arg-type]


def atomic_write(path: Path, content: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w") as stream:
            stream.write(content)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def read_state() -> dict[str, object]:
    try:
        return json.loads(STATE_FILE.read_text())
    except FileNotFoundError:
        return {}
    except (json.JSONDecodeError, OSError) as error:
        fail(f"Cannot read {STATE_FILE}: {error}")


def write_state(state: dict[str, object]) -> None:
    atomic_write(STATE_FILE, json.dumps(state, indent=2) + "\n")


def read_database_state() -> dict[str, object]:
    try:
        state = json.loads(DATABASE_STATE_FILE.read_text())
    except FileNotFoundError:
        return {}
    except (json.JSONDecodeError, OSError) as error:
        progress(f"Ignoring invalid database state at {DATABASE_STATE_FILE}: {error}")
        return {}
    return state if isinstance(state, dict) else {}


def write_database_state(*, initialized: bool, source: str) -> None:
    atomic_write(
        DATABASE_STATE_FILE,
        json.dumps({"initialized": initialized, "source": source}, indent=2) + "\n",
    )


def service_active(name: str) -> bool:
    result = sudo(["systemctl", "is-active", "--quiet", name], check=False)
    return result.returncode == 0


def systemctl(action: str, name: str) -> None:
    sudo(["systemctl", action, name])


def privileged_path_exists(path: Path, *, directory: bool = False) -> bool:
    result = sudo(["test", "-d" if directory else "-e", str(path)], check=False)
    return result.returncode == 0


def ensure_privileges() -> None:
    if os.geteuid() != 0:
        if shutil.which("sudo") is None:
            fail("This command needs root for Ubuntu packages and system services (sudo is not installed).")
        # Probe the non-interactive command path used below. `sudo -v` asks
        # for a credential timestamp even when commands are NOPASSWD.
        run(["sudo", "-n", "true"])
    if not Path("/run/systemd/system").exists():
        fail("This script expects an Ubuntu systemd container (for PostgreSQL and PHP-FPM services).")


def ensure_noble() -> None:
    release = {}
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            key, separator, value = line.partition("=")
            if separator:
                release[key] = value.strip().strip('"')
    except OSError as error:
        fail(f"Cannot identify the Ubuntu release: {error}")
    if release.get("ID") != "ubuntu" or release.get("VERSION_ID") != "24.04":
        fail("scripts/lxd-dev up currently supports Ubuntu 24.04 LTS (Noble) only.")


def package_installed(package: str) -> bool:
    result = run(
        ["dpkg-query", "-W", "-f=${db:Status-Status}", package],
        capture=True,
        check=False,
    )
    return result.returncode == 0 and result.stdout.strip() == "installed"


def ensure_apt_packages() -> None:
    missing = [package for package in APT_PACKAGES if not package_installed(package)]
    if not missing:
        return
    progress("Refreshing Ubuntu package indexes...")
    run(["apt-get", "update"] if os.geteuid() == 0 else ["sudo", "-n", "apt-get", "update"])
    progress("Installing Ubuntu development services and build prerequisites...")
    command = ["apt-get", "install", "-y", *missing]
    if os.geteuid() != 0:
        command = ["sudo", "-n", *command]

    # Debian package post-install hooks may start their default services. In a
    # container that can fail (for example, nginx's packaged IPv6 listener) or
    # collide with the isolated service configuration started below. Keep any
    # host-provided policy-rc.d intact; otherwise temporarily deny package
    # service actions while apt configures the packages.
    policy = Path("/usr/sbin/policy-rc.d")
    if policy.exists() or policy.is_symlink():
        run(command)
        return

    policy_script = Path("/run") / f"test-observer-lxd-dev-policy-rc.d-{os.getpid()}"
    sudo(["tee", str(policy_script)], input_text="#!/bin/sh\nexit 101\n", stdout=subprocess.DEVNULL)
    sudo(["chmod", "0755", str(policy_script)])
    policy_installed = False
    try:
        sudo(["ln", "-s", str(policy_script), str(policy)])
        policy_installed = True
        run(command)
    finally:
        if policy_installed:
            sudo(["rm", "-f", str(policy)])
        sudo(["rm", "-f", str(policy_script)])


def download(url: str, destination: Path) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_suffix(destination.suffix + ".part")
    try:
        run(["curl", "--fail", "--location", "--silent", "--show-error", "--output", str(temporary), url])
        temporary.replace(destination)
    finally:
        temporary.unlink(missing_ok=True)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def extract_snapshot_archive(
    archive_arg: str,
) -> tuple[tempfile.TemporaryDirectory[str], Path, Path]:
    archive = Path(archive_arg).expanduser().resolve()
    if not archive.is_file() or not os.access(archive, os.R_OK):
        fail(f"Snapshot archive is not a readable file: {archive}")
    if not zipfile.is_zipfile(archive):
        fail("Snapshot must be a ZIP containing a PostgreSQL directory-format dump.")

    preferred = Path("/tmp/opencode")
    temporary = tempfile.TemporaryDirectory(
        prefix="lxd-dev-snapshot-",
        dir=preferred if preferred.is_dir() else None,
    )
    root = Path(temporary.name)
    try:
        with zipfile.ZipFile(archive) as zipped:
            seen: set[str] = set()
            for member in zipped.infolist():
                name = member.filename
                relative = PurePosixPath(name)
                if (
                    not name
                    or "\\" in name
                    or relative.is_absolute()
                    or not relative.parts
                    or ".." in relative.parts
                    or ":" in relative.parts[0]
                ):
                    raise ValueError(f"Unsafe path in snapshot ZIP: {name!r}")
                normalized = relative.as_posix()
                if normalized in seen:
                    raise ValueError(f"Duplicate path in snapshot ZIP: {name!r}")
                seen.add(normalized)
                file_type = stat.S_IFMT(member.external_attr >> 16)
                if file_type not in (0, stat.S_IFREG, stat.S_IFDIR):
                    raise ValueError(f"Unsupported file type in snapshot ZIP: {name!r}")
            zipped.extractall(root)
    except (OSError, ValueError, zipfile.BadZipFile, RuntimeError) as error:
        temporary.cleanup()
        fail(f"Could not extract snapshot ZIP: {error}")

    toc_files = list(root.rglob("toc.dat"))
    if len(toc_files) != 1:
        temporary.cleanup()
        fail(f"Expected exactly one toc.dat in the snapshot ZIP, found {len(toc_files)}.")
    restore_list = root / f".lxd-dev-restore-{secrets.token_hex(8)}.list"
    return temporary, toc_files[0].parent, restore_list


def make_restore_list(archive_dir: Path, destination: Path) -> None:
    result = run(["pg_restore", "--list", str(archive_dir)], capture=True)
    unavailable_extensions = ("login_hook", "pgaudit", "set_user")
    entry_pattern = re.compile(
        r"\b(?:EXTENSION\s+-\s+|COMMENT\s+-\s+EXTENSION\s+)"
        rf"({'|'.join(unavailable_extensions)})(?:\s|$)",
        re.IGNORECASE,
    )
    filtered: list[str] = []
    skipped: set[str] = set()
    for line in (result.stdout or "").splitlines(keepends=True):
        match = entry_pattern.search(line)
        if match:
            skipped.add(match.group(1).lower())
        else:
            filtered.append(line)
    destination.write_text("".join(filtered), encoding="utf-8")
    if skipped:
        progress("Skipping unavailable local extensions: " + ", ".join(sorted(skipped)))


def source_fingerprint(paths: list[Path], settings: dict[str, str] | None = None) -> str:
    """Hash source file contents and build settings, independent of mtimes."""
    digest = hashlib.sha256()
    fingerprint_settings = {
        "cache_schema": str(BUILD_CACHE_SCHEMA),
        "system": platform.system(),
        "machine": platform.machine(),
        **(settings or {}),
    }
    digest.update(json.dumps(fingerprint_settings, sort_keys=True).encode())
    files: set[Path] = set()
    for path in paths:
        if path.is_file():
            files.add(path)
        elif path.is_dir():
            files.update(child for child in path.rglob("*") if child.is_file())
    for path in sorted(files):
        digest.update(path.relative_to(ROOT).as_posix().encode())
        digest.update(b"\0")
        digest.update(bytes.fromhex(sha256(path)))
    return digest.hexdigest()


def read_build_cache() -> dict[str, str]:
    try:
        cache = json.loads(BUILD_CACHE_FILE.read_text())
    except FileNotFoundError:
        return {}
    except (json.JSONDecodeError, OSError) as error:
        progress(f"Ignoring invalid build cache at {BUILD_CACHE_FILE}: {error}")
        return {}
    if not isinstance(cache, dict) or not all(isinstance(key, str) and isinstance(value, str) for key, value in cache.items()):
        progress(f"Ignoring invalid build cache at {BUILD_CACHE_FILE}.")
        return {}
    return cache


def save_build_cache(cache: dict[str, str]) -> None:
    atomic_write(BUILD_CACHE_FILE, json.dumps(cache, indent=2) + "\n")


def ensure_uv() -> Path:
    path = Path.home() / ".local/bin/uv"
    if path.exists():
        result = run([str(path), "--version"], capture=True, check=False)
        if result.returncode == 0 and UV_VERSION in (result.stdout or ""):
            return path
    pipx = shutil.which("pipx")
    if pipx is None:
        fail("Ubuntu pipx was not found after package installation.")
    progress(f"Installing Astral uv {UV_VERSION} from PyPI via Ubuntu's pipx package...")
    run([pipx, "install", "--force", f"uv=={UV_VERSION}"])
    if not path.exists():
        fail(f"pipx installed uv but {path} is missing; ensure ~/.local/bin is in PATH.")
    return path


def node_archive_details() -> tuple[str, str]:
    machine = platform.machine()
    if machine not in NODE_SHA256:
        fail(f"No pinned Node.js archive checksum is configured for {machine}.")
    arch = {"x86_64": "x64", "aarch64": "arm64"}[machine]
    archive = f"node-v{NODE_VERSION}-linux-{arch}.tar.xz"
    return archive, NODE_SHA256[machine]


def ensure_node() -> Path:
    version = run(["node", "--version"], capture=True, check=False) if shutil.which("node") else None
    if version and version.returncode == 0:
        match = re.match(r"v(\d+)\.(\d+)\.(\d+)", (version.stdout or "").strip())
        if match and int(match.group(1)) == 22 and (int(match.group(2)), int(match.group(3))) >= (13, 0):
            node_bin = Path(shutil.which("node") or "node").resolve().parent
            npm = node_bin / "npm"
            if npm.is_file() and os.access(npm, os.X_OK):
                npm_version = run([str(npm), "--version"], capture=True, check=False)
                if npm_version.returncode == 0:
                    return node_bin

    archive_name, expected_hash = node_archive_details()
    install_dir = Path.home() / ".local/opt" / f"node-v{NODE_VERSION}"
    node_bin = install_dir / "bin"
    if not (node_bin / "node").exists():
        if install_dir.exists():
            fail(f"{install_dir} exists without the expected Node.js binary; refusing to overwrite it.")
        archive = STATE_DIR / "downloads" / archive_name
        url = f"https://nodejs.org/dist/v{NODE_VERSION}/{archive_name}"
        progress(f"Downloading official Node.js {NODE_VERSION} from nodejs.org...")
        if not archive.exists() or sha256(archive) != expected_hash:
            download(url, archive)
        actual_hash = sha256(archive)
        if actual_hash != expected_hash:
            archive.unlink(missing_ok=True)
            fail(f"Node.js SHA-256 mismatch: expected {expected_hash}, got {actual_hash}.")
        install_dir.parent.mkdir(parents=True, exist_ok=True)
        temporary = install_dir.with_name(install_dir.name + ".installing")
        if temporary.exists():
            fail(f"Temporary Node.js installation path already exists: {temporary}; refusing to remove it.")
        temporary.mkdir()
        try:
            run(["tar", "-xJf", str(archive), "--strip-components=1", "-C", str(temporary)])
            if not (temporary / "bin/node").is_file() or not (temporary / "bin/npm").is_file():
                fail("Node.js archive did not contain node and npm binaries.")
            temporary.rename(install_dir)
        except BaseException:
            shutil.rmtree(temporary, ignore_errors=True)
            raise
    return node_bin


def ensure_flutter() -> Path:
    install_dir = Path.home() / ".local/opt" / f"flutter-{FLUTTER_TAG}"
    if install_dir.exists():
        result = run(["git", "-C", str(install_dir), "rev-parse", "HEAD"], capture=True, check=False)
        if result.returncode != 0 or (result.stdout or "").strip() != FLUTTER_COMMIT:
            fail(f"{install_dir} exists but is not the pinned Flutter {FLUTTER_TAG} revision; refusing to use it.")
    else:
        temporary = install_dir.with_name(install_dir.name + ".installing")
        if temporary.exists():
            fail(f"Temporary Flutter installation path already exists: {temporary}; refusing to remove it.")
        progress(f"Cloning Flutter {FLUTTER_TAG} from the official Flutter repository...")
        try:
            run([
                "git", "clone", "--depth", "1", "--branch", FLUTTER_TAG,
                "https://github.com/flutter/flutter.git", str(temporary),
            ])
        except BaseException:
            shutil.rmtree(temporary, ignore_errors=True)
            raise
        result = run(["git", "-C", str(temporary), "rev-parse", "HEAD"], capture=True)
        if (result.stdout or "").strip() != FLUTTER_COMMIT:
            shutil.rmtree(temporary, ignore_errors=True)
            fail("Flutter tag 3.29.3 did not resolve to the expected commit; refusing to build it.")
        temporary.rename(install_dir)
    flutter = install_dir / "bin/flutter"
    run([str(flutter), "config", "--enable-web", "--no-enable-android"])
    return install_dir / "bin"


def ensure_simple_saml(secrets_state: dict[str, str], public_ip: str) -> Path:
    install_parent = SYSTEM_DIR
    install_dir = install_parent / f"simplesamlphp-{SIMPLESAMLPHP_VERSION}"
    current = install_parent / "simplesamlphp"
    archive = STATE_DIR / "downloads" / f"simplesamlphp-{SIMPLESAMLPHP_VERSION}-full.tar.gz"
    if not privileged_path_exists(install_dir, directory=True):
        progress(f"Downloading the official SimpleSAMLphp {SIMPLESAMLPHP_VERSION} full release...")
        if not archive.exists() or sha256(archive) != SIMPLESAMLPHP_SHA256:
            download(SIMPLESAMLPHP_URL, archive)
        actual_hash = sha256(archive)
        if actual_hash != SIMPLESAMLPHP_SHA256:
            archive.unlink(missing_ok=True)
            fail(f"SimpleSAMLphp SHA-256 mismatch: expected {SIMPLESAMLPHP_SHA256}, got {actual_hash}.")
        sudo(["install", "-d", "-o", "root", "-g", "www-data", "-m", "0750", str(install_parent)])
        sudo(["tar", "--no-same-owner", "-xzf", str(archive), "-C", str(install_parent)])
        if not privileged_path_exists(install_dir, directory=True):
            fail(f"SimpleSAMLphp archive did not contain the expected directory {install_dir}.")
    sudo(["ln", "-sfn", str(install_dir), str(current)])

    config_dir = current / "config"
    metadata_dir = current / "metadata"
    cert_dir = SYSTEM_STATE_DIR / "cert"
    cache_dir = SYSTEM_STATE_DIR / "cache"
    sudo(["install", "-d", "-o", "root", "-g", "www-data", "-m", "0750", str(config_dir)])
    sudo(["install", "-d", "-o", "root", "-g", "www-data", "-m", "0750", str(metadata_dir)])
    sudo(["install", "-d", "-o", "root", "-g", "www-data", "-m", "0750", str(cert_dir)])
    sudo(["install", "-d", "-o", "www-data", "-g", "www-data", "-m", "0750", str(cache_dir)])

    if not privileged_path_exists(config_dir / "config.php"):
        sudo([
            "install", "-o", "root", "-g", "www-data", "-m", "0640",
            str(config_dir / "config.php.dist"), str(config_dir / "config.php"),
        ])

    repo_config = BACKEND / "saml/simplesamlphp"
    for source, destination in (
        (repo_config / "authsources.php", config_dir / "authsources.php"),
        (repo_config / "config-override.php", config_dir / "config-override.php"),
        (repo_config / "saml20-idp-hosted.php", metadata_dir / "saml20-idp-hosted.php"),
        (repo_config / "saml20-sp-remote.php", metadata_dir / "saml20-sp-remote.php"),
    ):
        content = source.read_text()
        if source.name == "saml20-sp-remote.php":
            # PHP-FPM does not inherit the SAML_SP_BASE_URL set by this script,
            # so bake the LXD API address into its remote-SP metadata fallback.
            content = content.replace("http://localhost:30000", f"http://{public_ip}:30000")
        sudo(["tee", str(destination)], input_text=content, stdout=subprocess.DEVNULL)
        sudo(["chmod", "0640", str(destination)])
        sudo(["chown", "root:www-data", str(destination)])

    if "secretsalt" not in secrets_state:
        secrets_state["secretsalt"] = secrets.token_urlsafe(32)
    if "assets_salt" not in secrets_state:
        secrets_state["assets_salt"] = secrets.token_urlsafe(32)
    if "admin_password_hash" not in secrets_state:
        password = os.environ.get("SSP_ADMIN_PASSWORD", "secret1")
        result = sudo(["php", str(current / "bin/pwgen.php")], capture=True, input_text=password + "\n")
        match = re.search(r"Password hash:\s*\n([^\r\n]+)", result.stdout or "")
        if not match:
            fail("Could not generate the SimpleSAMLphp administrator password hash.")
        secrets_state["admin_password_hash"] = match.group(1).strip()
    atomic_write(SECRETS_FILE, json.dumps(secrets_state, indent=2) + "\n")

    overrides = "\n".join([
        "<?php",
        "require_once __DIR__ . '/config-override.php';",
        f"$config['baseurlpath'] = {php_string(f'http://{public_ip}:8080/simplesaml/')};",
        f"$config['certdir'] = {php_string(str(cert_dir))};",
        f"$config['cachedir'] = {php_string(str(cache_dir))};",
        f"$config['secretsalt'] = {php_string(secrets_state['secretsalt'])};",
        f"$config['assets']['salt'] = {php_string(secrets_state['assets_salt'])};",
        f"$config['auth.adminpassword'] = {php_string(secrets_state['admin_password_hash'])};",
        "$config['logging.handler'] = 'errorlog';",
        "$config['module.enable']['exampleauth'] = true;",
        "",
    ])
    sudo(["tee", str(config_dir / "lxd-dev-config.php")], input_text=overrides, stdout=subprocess.DEVNULL)
    config_php = sudo(["cat", str(config_dir / "config.php")], capture=True).stdout or ""
    include = "require_once __DIR__ . '/lxd-dev-config.php';"
    if include not in config_php:
        sudo(["tee", "-a", str(config_dir / "config.php")], input_text=f"\n{include}\n", stdout=subprocess.DEVNULL)

    if not privileged_path_exists(cert_dir / "server.pem") or not privileged_path_exists(
        cert_dir / "server.crt"
    ):
        sudo([
            "openssl", "req", "-newkey", "rsa:2048", "-new", "-x509", "-days", "3652", "-nodes",
            "-out", str(cert_dir / "server.crt"),
            "-keyout", str(cert_dir / "server.pem"),
            "-subj", "/C=NA/ST=NA/L=NA/O=TestObserver/OU=Dev/CN=localhost",
        ])
        sudo(["chmod", "0644", str(cert_dir / "server.crt")])
        sudo(["chmod", "0640", str(cert_dir / "server.pem")])
        sudo(["chown", "root:www-data", str(cert_dir / "server.pem"), str(cert_dir / "server.crt")])

    sudo(["chown", "-R", "root:www-data", str(install_dir)])
    return current


def read_simple_saml_secrets() -> dict[str, str]:
    if not SECRETS_FILE.exists():
        return {}
    try:
        return json.loads(SECRETS_FILE.read_text())
    except (json.JSONDecodeError, OSError) as error:
        fail(f"Cannot read SimpleSAMLphp local secrets at {SECRETS_FILE}: {error}")
    raise AssertionError("unreachable")


def php_string(value: str) -> str:
    return "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"


def configure_runtime_environment(env: dict[str, str], public_ip: str) -> None:
    """Set address-dependent application settings for this stack startup."""
    public_api_url = f"http://{public_ip}:30000"
    env.update({
        "SAML_IDP_METADATA_URL": f"http://{public_ip}:8080/simplesaml/saml2/idp/metadata.php",
        "SAML_SP_BASE_URL": public_api_url,
        "FRONTEND_URL": f"http://{public_ip}:30001",
    })


def service_ip() -> str:
    """Return the container's IPv4 address selected for the default route."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
            probe.connect(("192.0.2.1", 80))
            address = probe.getsockname()[0]
            if not address.startswith("127."):
                return address
    except OSError:
        pass

    # A container without a default route can still have a directly assigned
    # address. Use the first non-loopback IPv4 address resolved for its hostname.
    try:
        for result in socket.getaddrinfo(socket.gethostname(), None, socket.AF_INET, socket.SOCK_STREAM):
            address = result[4][0]
            if not address.startswith("127."):
                return address
    except socket.gaierror:
        pass
    fail("Could not determine a non-loopback IPv4 address for the container.")
    raise AssertionError("unreachable")


def build_frontend(
    env: dict[str, str],
    flutter_bin: Path,
    node_bin: Path,
    public_ip: str,
    cache: dict[str, str],
) -> None:
    current_path = os.environ.get("PATH", "")
    env["PATH"] = os.pathsep.join([str(node_bin), str(flutter_bin), str(Path.home() / ".local/bin"), current_path])
    flutter = flutter_bin / "flutter"
    dart = flutter_bin / "dart"
    flutter_dependencies = source_fingerprint(
        [FRONTEND / "pubspec.yaml", FRONTEND / "pubspec.lock", FRONTEND / "pubspec_overrides.yaml"],
        {"flutter": FLUTTER_COMMIT, "command": "flutter pub get"},
    )
    if (
        cache.get("flutter_dependencies") != flutter_dependencies
        or not (FRONTEND / ".dart_tool/package_config.json").is_file()
    ):
        progress("Resolving Flutter dependencies...")
        run([str(flutter), "pub", "get"], cwd=FRONTEND, env=env, check=True)
        cache["flutter_dependencies"] = flutter_dependencies
        save_build_cache(cache)
    else:
        progress("Reusing cached Flutter dependencies.")

    flutter_codegen_inputs = [
        FRONTEND / "lib",
        FRONTEND / "pubspec.yaml",
        FRONTEND / "pubspec.lock",
        FRONTEND / "pubspec_overrides.yaml",
        FRONTEND / "build.yaml",
    ]
    flutter_codegen = source_fingerprint(
        flutter_codegen_inputs,
        {"flutter": FLUTTER_COMMIT, "command": "build_runner build"},
    )
    if cache.get("flutter_codegen") != flutter_codegen:
        progress("Generating the Flutter frontend API code...")
        run([
            str(dart), "run", "build_runner", "build", "--delete-conflicting-outputs",
        ], cwd=FRONTEND, env=env, check=True)
        cache["flutter_codegen"] = source_fingerprint(
            flutter_codegen_inputs,
            {"flutter": FLUTTER_COMMIT, "command": "build_runner build"},
        )
        save_build_cache(cache)
    else:
        progress("Reusing cached Flutter generated code.")

    flutter_build_inputs = [
        FRONTEND / "lib",
        FRONTEND / "web",
        FRONTEND / "assets",
        FRONTEND / "pubspec.yaml",
        FRONTEND / "pubspec.lock",
        FRONTEND / "pubspec_overrides.yaml",
        FRONTEND / "analysis_options.yaml",
    ]
    flutter_build = source_fingerprint(
        flutter_build_inputs,
        {"flutter": FLUTTER_COMMIT, "mode": "release", "api_ip": public_ip},
    )
    flutter_webroot = FRONTEND / "build/web"
    flutter_outputs_exist = all(
        (flutter_webroot / output).is_file()
        for output in ("index.html", "main.dart.js", "flutter_bootstrap.js")
    )
    if cache.get("flutter_web") != flutter_build or not flutter_outputs_exist:
        progress("Building the Flutter frontend...")
        run([str(flutter), "build", "web", "--release"], cwd=FRONTEND, env=env, check=True)
        cache["flutter_web"] = flutter_build
        save_build_cache(cache)
    else:
        progress("Reusing cached Flutter web build.")

    sveltekit = FRONTEND / "sveltekit"
    npm = node_bin / "npm"
    node_version = run([str(node_bin / "node"), "--version"], capture=True, env=env).stdout or "unknown"
    npm_version = run([str(npm), "--version"], capture=True, env=env).stdout or "unknown"
    svelte_dependencies = source_fingerprint(
        [
            sveltekit / "package.json",
            sveltekit / "package-lock.json",
            sveltekit / "npm-shrinkwrap.json",
            sveltekit / ".npmrc",
        ],
        {"node": node_version.strip(), "npm": npm_version.strip(), "command": "npm ci"},
    )
    if (
        cache.get("svelte_dependencies") != svelte_dependencies
        or not (sveltekit / "node_modules/.bin/vite").exists()
    ):
        progress("Installing locked SvelteKit dependencies...")
        run([str(npm), "ci"], cwd=sveltekit, env=env, check=True)
        cache["svelte_dependencies"] = svelte_dependencies
        save_build_cache(cache)
    else:
        progress("Reusing cached SvelteKit dependencies.")

    svelte_env = dict(env)
    svelte_env["BASE_PATH"] = "/wip"
    svelte_build_config = [
        sveltekit / name
        for name in (
            "package.json",
            "package-lock.json",
            "npm-shrinkwrap.json",
            "vite.config.ts",
            "svelte.config.js",
            "svelte.config.ts",
            "tsconfig.json",
        )
        if (sveltekit / name).is_file()
    ]
    svelte_build_config.extend(
        path for path in sveltekit.iterdir() if path.is_file() and path.name.startswith(".env")
    )
    svelte_build = source_fingerprint(
        [sveltekit / "src", sveltekit / "static", *svelte_build_config],
        {
            "node": node_version.strip(),
            "npm": npm_version.strip(),
            "base_path": svelte_env["BASE_PATH"],
            "api_ip": public_ip,
        },
    )
    svelte_webroot = sveltekit / "build"
    svelte_outputs_exist = (svelte_webroot / "200.html").is_file() and any(
        asset.is_file() for asset in (svelte_webroot / "_app").rglob("*")
    )
    if cache.get("svelte_build") != svelte_build or not svelte_outputs_exist:
        progress("Building the /wip SvelteKit frontend...")
        run([str(npm), "run", "build"], cwd=sveltekit, env=svelte_env, check=True)
        cache["svelte_build"] = svelte_build
        save_build_cache(cache)
    else:
        progress("Reusing cached SvelteKit build.")

    webroot = FRONTEND / "build/web"
    webroot.mkdir(parents=True, exist_ok=True)
    shutil.copytree(svelte_webroot, webroot / "wip", dirs_exist_ok=True)
    for asset in webroot.rglob("*"):
        if not asset.is_file():
            continue
        try:
            content = asset.read_text()
        except (OSError, UnicodeDecodeError):
            continue
        updated = content.replace("localhost:30000", f"{public_ip}:30000")
        if updated != content:
            asset.write_text(updated)
    sudo(["install", "-d", "-o", "root", "-g", "www-data", "-m", "0750", str(WEBROOT)])
    sudo(["cp", "-a", str(webroot) + "/.", str(WEBROOT) + "/"])
    sudo(["chown", "-R", "root:www-data", str(WEBROOT)])


def nginx_quote(path: Path | str) -> str:
    return '"' + str(path).replace("\\", "\\\\").replace('"', '\\"') + '"'


def write_nginx_config(saml_dir: Path) -> tuple[Path, Path]:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    prefix = SYSTEM_STATE_DIR / "nginx"
    directories = (
        prefix,
        prefix / "logs",
        prefix / "client_body_temp",
        prefix / "proxy_temp",
        prefix / "fastcgi_temp",
        prefix / "uwsgi_temp",
        prefix / "scgi_temp",
    )
    for directory in directories:
        sudo(["install", "-d", "-o", "root", "-g", "www-data", "-m", "0770", str(directory)])
    config = STATE_DIR / "nginx.conf"
    frontend_root = WEBROOT
    saml_public_dir = saml_dir / "public"
    conf = f"""user www-data;
worker_processes 1;
pid {nginx_quote(prefix / 'nginx.pid')};
error_log {nginx_quote(prefix / 'logs/error.log')} warn;
events {{ worker_connections 1024; }}
http {{
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log {nginx_quote(prefix / 'logs/access.log')};
    client_body_temp_path {nginx_quote(prefix / 'client_body_temp')};
    proxy_temp_path {nginx_quote(prefix / 'proxy_temp')};
    fastcgi_temp_path {nginx_quote(prefix / 'fastcgi_temp')};
    uwsgi_temp_path {nginx_quote(prefix / 'uwsgi_temp')};
    scgi_temp_path {nginx_quote(prefix / 'scgi_temp')};

    server {{
        listen 30001;
        server_name localhost _;
        root {nginx_quote(frontend_root)};
        location /wip/ {{
            index 200.html;
            try_files $uri $uri/ /wip/200.html =404;
        }}
        location / {{
            try_files $uri $uri/ /index.html;
        }}
    }}

    server {{
        listen 8080;
        server_name localhost _;
        location /simplesaml/ {{
            alias {nginx_quote(str(saml_public_dir) + "/")};
        }}
        location ~ ^(?<prefix>/simplesaml)(?<phpfile>.+?\\.php)(?<pathinfo>/.*)?$ {{
            include /etc/nginx/fastcgi_params;
            fastcgi_pass unix:/run/php/php8.3-fpm.sock;
            fastcgi_param SCRIPT_FILENAME {nginx_quote(saml_public_dir)[:-1]}$phpfile";
            fastcgi_param SCRIPT_NAME /simplesaml$phpfile;
            fastcgi_param PATH_INFO $pathinfo if_not_empty;
            fastcgi_param SIMPLESAMLPHP_CONFIG_DIR {nginx_quote(saml_dir / 'config')};
        }}
    }}
}}
"""
    atomic_write(config, conf, 0o644)
    return config, prefix


def wait_http(url: str, *, timeout: int = 90) -> None:
    deadline = time.monotonic() + timeout
    last_error = "no response"
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=2) as response:
                if 200 <= response.status < 400:
                    return
                last_error = f"HTTP {response.status}"
        except (urllib.error.URLError, TimeoutError, OSError) as error:
            last_error = str(error)
        time.sleep(2)
    fail(f"Timed out waiting for {url}: {last_error}")


def wait_for_seed_completion(pid: int, log_path: Path, log_offset: int, *, timeout: int = 300) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            with log_path.open("r") as log:
                log.seek(log_offset)
                seed_log = log.read()
        except OSError:
            seed_log = ""
        if (
            "Database seeding completed successfully!" in seed_log
            or "Database already contains data. Skipping seed operation." in seed_log
        ):
            return
        if not is_process_alive(pid, str(BACKEND / "dev_entrypoint.sh")):
            fail(f"Backend exited before initial database seeding completed; check {STATE_DIR / 'api.log'}.")
        time.sleep(1)
    fail(f"Timed out waiting for initial database seeding; check {STATE_DIR / 'api.log'}.")


def postgres_psql(database: str, statement: str, *, capture: bool = False) -> subprocess.CompletedProcess[str]:
    return sudo(
        [
            "-u", "postgres", "psql", "-X", "-A", "-t", "-v", "ON_ERROR_STOP=1", "-d", database,
            "-c", statement,
        ],
        capture=capture,
    )


def ensure_database() -> None:
    systemctl("start", "postgresql")
    role_exists = sudo(
        [
            "-u", "postgres", "psql", "-At", "-d", "postgres", "-c",
            f"SELECT 1 FROM pg_roles WHERE rolname = '{DB_USER}'",
        ],
        capture=True,
    )
    role_command = "ALTER ROLE" if (role_exists.stdout or "").strip() == "1" else "CREATE ROLE"
    sudo([
        "-u", "postgres", "psql", "-v", "ON_ERROR_STOP=1", "-d", "postgres",
        "-c", f"{role_command} {DB_USER} WITH LOGIN SUPERUSER PASSWORD '{DB_PASSWORD}'",
    ])
    exists = sudo(
        [
            "-u", "postgres", "psql", "-At", "-d", "postgres", "-c",
            f"SELECT 1 FROM pg_database WHERE datname = '{DB_NAME}'",
        ],
        capture=True,
    )
    if (exists.stdout or "").strip() != "1":
        sudo(["-u", "postgres", "createdb", "-O", DB_USER, DB_NAME])


def database_is_initialized() -> bool:
    result = postgres_psql(
        DB_NAME,
        "SELECT to_regclass('public.alembic_version') IS NOT NULL",
        capture=True,
    )
    return (result.stdout or "").strip() == "t"


def should_seed_database() -> bool:
    state = read_database_state()
    if not database_is_initialized():
        # Keep a pending marker until the entrypoint confirms seeding finished.
        write_database_state(initialized=False, source="seeded")
        return True
    if state.get("initialized") is False:
        # This can happen if startup stopped after migrations but during seeding.
        return True
    if state.get("initialized") is not True:
        # Preserve databases initialized by older versions of the LXD workflow.
        write_database_state(initialized=True, source="existing")
    return False


def database_exists(name: str) -> bool:
    result = postgres_psql(
        "postgres",
        f"SELECT 1 FROM pg_database WHERE datname = '{name}'",
        capture=True,
    )
    return (result.stdout or "").strip() == "1"


def drop_database(name: str) -> None:
    if database_exists(name):
        postgres_psql(
            "postgres",
            f"SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '{name}'",
        )
        sudo(["-u", "postgres", "dropdb", name])


def swap_database(staging_database: str) -> None:
    backup_database = f"test_observer_old_{os.getpid()}_{secrets.token_hex(4)}"
    has_existing_database = database_exists(DB_NAME)
    if has_existing_database:
        postgres_psql(
            "postgres",
            f"SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '{DB_NAME}'",
        )
        postgres_psql("postgres", f"ALTER DATABASE {DB_NAME} RENAME TO {backup_database}")

    try:
        postgres_psql("postgres", f"ALTER DATABASE {staging_database} RENAME TO {DB_NAME}")
    except BaseException:
        if has_existing_database and database_exists(backup_database) and not database_exists(DB_NAME):
            postgres_psql("postgres", f"ALTER DATABASE {backup_database} RENAME TO {DB_NAME}")
        raise

    if has_existing_database:
        try:
            drop_database(backup_database)
        except subprocess.CalledProcessError as error:
            progress(f"The old database remains available as {backup_database}: {error}")


def restore_snapshot(
    archive_dir: Path,
    restore_list: Path,
    uv: Path,
    env: dict[str, str],
) -> None:
    staging_database = f"test_observer_restore_{os.getpid()}_{secrets.token_hex(4)}"
    sudo(["-u", "postgres", "createdb", "-O", DB_USER, staging_database])
    stage_exists = True
    try:
        pg_env = os.environ.copy()
        for variable in ("PGHOST", "PGPORT", "PGDATABASE", "PGUSER", "PGSERVICE", "PGSERVICEFILE", "PGOPTIONS"):
            pg_env.pop(variable, None)
        pg_env["PGPASSWORD"] = DB_PASSWORD
        progress("Restoring the PostgreSQL directory dump into a staging database...")
        run(
            [
                "pg_restore", "--host", "127.0.0.1", "--port", "5432", "--username", DB_USER,
                "--dbname", staging_database, "--no-owner", "--no-privileges", "--exit-on-error",
                "--use-list", str(restore_list), str(archive_dir),
            ],
            env=pg_env,
        )

        staging_env = dict(env)
        staging_env["DB_URL"] = (
            f"postgresql+pg8000://{DB_USER}:{DB_PASSWORD}@localhost:5432/{staging_database}"
        )
        progress("Applying current application migrations to the snapshot...")
        run([str(uv), "run", "alembic", "upgrade", "head"], cwd=BACKEND, env=staging_env)

        progress("Sanitizing restored identities, sessions, and API keys...")
        run(
            [
                "psql", "-X", "--quiet", "--set=ON_ERROR_STOP=1", "--host", "127.0.0.1", "--port", "5432",
                "--username", DB_USER, "--dbname", staging_database, "--file", str(BACKEND / "scripts/byodb_sanitize.sql"),
            ],
            env=pg_env,
        )

        progress("Replacing the local database with the prepared snapshot...")
        swap_database(staging_database)
        stage_exists = False
    finally:
        if stage_exists:
            try:
                drop_database(staging_database)
            except subprocess.CalledProcessError as error:
                progress(f"Could not remove incomplete staging database {staging_database}: {error}")


def is_process_alive(pid: object, expected: str | None = None) -> bool:
    if not isinstance(pid, int) or pid <= 1:
        return False
    try:
        command_line = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
    except OSError:
        return False
    return expected is None or expected in command_line


def api_session_processes(session_id: int, token: str) -> list[int]:
    """Find this startup's processes in its isolated API session."""
    token_entry = f"LXD_DEV_API_GROUP_TOKEN={token}".encode()
    processes: list[int] = []
    for process_dir in Path("/proc").iterdir():
        if not process_dir.name.isdecimal():
            continue
        try:
            stat_fields = process_dir.joinpath("stat").read_text().rsplit(")", 1)[1].split()
            # The fields following comm start with state (field 3); session
            # (field 6) is therefore at index 3. Descendants may create their
            # own process groups but remain members of this isolated session.
            if int(stat_fields[3]) != session_id:
                continue
            environment = process_dir.joinpath("environ").read_bytes().split(b"\0")
        except (IndexError, OSError, ValueError):
            continue
        if token_entry in environment:
            processes.append(int(process_dir.name))
    return processes


def signal_api_session(session_id: int, token: str, sig: int) -> None:
    """Signal only token-matching API processes, pinning each PID with a pidfd."""
    pidfd_open = getattr(os, "pidfd_open", None)
    pidfd_send_signal = getattr(signal, "pidfd_send_signal", None)
    if pidfd_open is None or pidfd_send_signal is None:
        # Never fall back to killpg here: after the wrapper exits its PID/SID
        # could have been reused, and a broad signal could hit an unrelated job.
        return

    for candidate in api_session_processes(session_id, token):
        try:
            pidfd = pidfd_open(candidate)
        except (ProcessLookupError, PermissionError, OSError):
            continue
        try:
            # Re-check identity after opening the pidfd. Even if the numeric
            # PID was reused during discovery, the descriptor now pins that
            # process and the token check prevents signaling it by mistake.
            if candidate not in api_session_processes(session_id, token):
                continue
            try:
                pidfd_send_signal(pidfd, sig)
            except (ProcessLookupError, PermissionError, OSError):
                pass
        finally:
            os.close(pidfd)


def stop_api(pid: object, group_token: object = None) -> None:
    if isinstance(pid, int) and pid > 1 and isinstance(group_token, str) and group_token:
        signal_api_session(pid, group_token, signal.SIGTERM)
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline and api_session_processes(pid, group_token):
            time.sleep(0.2)
        if api_session_processes(pid, group_token):
            signal_api_session(pid, group_token, signal.SIGKILL)
        return

    # State files written by older versions do not have a group token. Retain
    # the existing wrapper-identity guard for those entries; never infer that
    # a mismatched PID's process group belongs to the API without the token.
    expected_command = str(BACKEND / "dev_entrypoint.sh")
    if not is_process_alive(pid, expected_command):
        return
    try:
        os.killpg(int(pid), signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        return
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline and is_process_alive(pid, expected_command):
        time.sleep(0.2)
    if is_process_alive(pid, expected_command):
        try:
            os.killpg(int(pid), signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass


def stop(state: dict[str, object]) -> None:
    config_path = STATE_DIR / "nginx.conf"
    prefix = SYSTEM_STATE_DIR / "nginx"
    pid_path = prefix / "nginx.pid"
    if privileged_path_exists(pid_path) and config_path.exists():
        sudo(["nginx", "-s", "quit", "-c", str(config_path), "-p", str(prefix) + "/"], check=False)
        deadline = time.monotonic() + 10
        while privileged_path_exists(pid_path) and time.monotonic() < deadline:
            time.sleep(0.2)
        if privileged_path_exists(pid_path):
            try:
                result = sudo(["cat", str(pid_path)], capture=True, check=False)
                nginx_pid = int((result.stdout or "").strip())
                if is_process_alive(nginx_pid, str(config_path)):
                    sudo(["kill", "-TERM", str(nginx_pid)], check=False)
            except OSError:
                pass
            except ValueError:
                progress(f"Ignoring invalid nginx PID file: {pid_path}")

    stop_api(state.get("api_pid"), state.get("api_group_token"))
    services_were_active = state.get("services_were_active", {})
    if isinstance(services_were_active, dict):
        for service in ("php8.3-fpm", "postgresql"):
            if services_were_active.get(service) is False and service_active(service):
                progress(f"Stopping {service} (it was started by lxd-dev).")
                systemctl("stop", service)
    STATE_FILE.unlink(missing_ok=True)


def up(snapshot_arg: str | None = None) -> None:
    ensure_noble()
    ensure_privileges()
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    temporary: tempfile.TemporaryDirectory[str] | None = None
    prepared_snapshot: tuple[Path, Path] | None = None
    if snapshot_arg:
        temporary, archive_dir, restore_list = extract_snapshot_archive(snapshot_arg)
        prepared_snapshot = (archive_dir, restore_list)
    try:
        up_stack(prepared_snapshot)
    finally:
        if temporary is not None:
            temporary.cleanup()


def up_stack(prepared_snapshot: tuple[Path, Path] | None) -> None:
    existing = read_state()
    public_ip = service_ip()
    public_api_url = f"http://{public_ip}:30000"
    public_frontend_url = f"http://{public_ip}:30001"
    public_idp_url = f"http://{public_ip}:8080/simplesaml/"
    if prepared_snapshot is not None and shutil.which("pg_restore"):
        make_restore_list(*prepared_snapshot)
    if existing and is_process_alive(existing.get("api_pid"), str(BACKEND / "dev_entrypoint.sh")):
        if prepared_snapshot is None and existing.get("public_ip") == public_ip:
            progress("The Test Observer development stack is already running.")
            progress("Refreshing SimpleSAMLphp metadata for the container IP...")
            ensure_simple_saml(read_simple_saml_secrets(), public_ip)
            print(f"API: {public_api_url}\nFrontend: {public_frontend_url}\nSAML IdP: {public_idp_url}")
            return
        if prepared_snapshot is None:
            progress("The container IP changed; restarting the stack to refresh address-dependent configuration...")
        else:
            progress("Stopping the running stack to apply the supplied database snapshot...")
        stop(existing)
        existing = {}
    if existing:
        stop(existing)

    services_were_active = {
        service: service_active(service)
        for service in ("postgresql", "php8.3-fpm", "nginx")
    }
    state: dict[str, object] = {
        "services_were_active": services_were_active,
        "startup_attempt": secrets.token_hex(8),
        "public_ip": public_ip,
    }
    write_state(state)

    ensure_apt_packages()
    if prepared_snapshot is not None and not prepared_snapshot[1].is_file():
        make_restore_list(*prepared_snapshot)
    # The packaged nginx default site may bind port 80. This stack uses a
    # private config on 30001 and 8080, so stop the package service if apt
    # started it during installation.
    if not services_were_active["nginx"] and service_active("nginx"):
        systemctl("stop", "nginx")

    uv = ensure_uv()
    node_bin = ensure_node()
    flutter_bin = ensure_flutter()
    env = os.environ.copy()
    env["PATH"] = os.pathsep.join([
        str(node_bin),
        str(flutter_bin),
        str(Path.home() / ".local/bin"),
        env.get("PATH", ""),
    ])
    env.update({
        "DB_URL": f"postgresql+pg8000://{DB_USER}:{DB_PASSWORD}@localhost:5432/{DB_NAME}",
        "DISABLE_PERIODIC_TASKS": "true",
        "UV_DYNAMIC_VERSIONING_BYPASS": "0.0.0",
        "SESSIONS_HTTPS_ONLY": "false",
        "USE_LOCAL_LOGIN": "true",
        "PYTHONDONTWRITEBYTECODE": "1",
    })
    configure_runtime_environment(env, public_ip)
    env["UV"] = str(uv)

    build_cache = read_build_cache()
    uv_version = run([str(uv), "--version"], capture=True).stdout or "unknown"
    backend_dependencies = source_fingerprint(
        [BACKEND / "pyproject.toml", BACKEND / "uv.lock", BACKEND / "uv.toml", BACKEND / ".python-version"],
        {
            "uv": uv_version.strip(),
            "python": platform.python_version(),
            "groups": "all",
            "frozen": "true",
        },
    )
    if (
        build_cache.get("backend_dependencies") != backend_dependencies
        or not (BACKEND / ".venv/bin/python").is_file()
    ):
        progress("Installing backend dependencies from backend/uv.lock...")
        run([str(uv), "sync", "--frozen", "--all-groups"], cwd=BACKEND, env=env)
        build_cache["backend_dependencies"] = backend_dependencies
        save_build_cache(build_cache)
    else:
        progress("Reusing cached backend dependencies.")

    build_frontend(env, flutter_bin, node_bin, public_ip, build_cache)

    secrets_state = read_simple_saml_secrets()
    saml_dir = ensure_simple_saml(secrets_state, public_ip)

    if not services_were_active["php8.3-fpm"]:
        state["services_were_active"] = services_were_active
        write_state(state)
    systemctl("start", "php8.3-fpm")
    ensure_database()
    if prepared_snapshot is not None:
        restore_snapshot(*prepared_snapshot, uv, env)
        write_database_state(initialized=True, source="snapshot")
        seed_data = False
        progress("Snapshot is installed; startup seeding is disabled.")
        progress("The source archive and restored database remain sensitive local data.")
    else:
        seed_data = should_seed_database()
        if seed_data:
            progress("The database is uninitialized; it will be seeded on first startup.")
        else:
            progress("Using the existing database without adding seed data.")
    env["SEED_DATA"] = "true" if seed_data else "false"
    env.pop("SEED_COMPLETION_FILE", None)

    config_path, prefix = write_nginx_config(saml_dir)
    sudo(["nginx", "-t", "-c", str(config_path), "-p", str(prefix) + "/"])
    progress("Starting the frontend and SimpleSAMLphp through the pinned nginx configuration...")
    sudo(["nginx", "-c", str(config_path), "-p", str(prefix) + "/"])
    wait_http(IDP_URL)

    progress("Starting the API; pending migrations will be applied automatically...")
    log_path = STATE_DIR / "api.log"
    log_offset = log_path.stat().st_size if log_path.exists() else 0
    api_group_token = secrets.token_hex(32)
    env["LXD_DEV_API_GROUP_TOKEN"] = api_group_token
    with log_path.open("a") as log:
        process = subprocess.Popen(
            [str(BACKEND / "dev_entrypoint.sh")],
            cwd=BACKEND,
            env=env,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    state["api_pid"] = process.pid
    state["api_group_token"] = api_group_token
    write_state(state)
    wait_http(f"{API_URL}/health/ready", timeout=180)
    if seed_data:
        wait_for_seed_completion(process.pid, log_path, log_offset)
        write_database_state(initialized=True, source="seeded")
    wait_http(FRONTEND_URL)

    print("Test Observer development services are ready:")
    print(f"  API:       {public_api_url}")
    print(f"  Frontend:  {public_frontend_url}")
    print(f"  SAML IdP:  {public_idp_url}")
    print("Stop them with: scripts/lxd-dev down")


def down() -> None:
    state = read_state()
    if not state and not privileged_path_exists(SYSTEM_STATE_DIR / "nginx/nginx.pid"):
        print("The Test Observer development stack is not running.")
        return
    ensure_privileges()
    stop(state)
    print("Test Observer development services stopped. PostgreSQL data and installed packages were kept.")


def main(argv: list[str]) -> None:
    snapshot_arg: str | None = None
    if argv == ["down"]:
        command = "down"
    elif argv == ["up"]:
        command = "up"
    elif len(argv) == 3 and argv[0] == "up" and argv[1] == "--snapshot" and argv[2]:
        command = "up"
        snapshot_arg = argv[2]
    else:
        print(f"Usage: {Path(sys.argv[0]).name} up [--snapshot ZIP] | down", file=sys.stderr)
        raise SystemExit(2)
    if not (ROOT / "backend/pyproject.toml").is_file() or not (ROOT / "docker-compose.yml").is_file():
        fail("Run scripts/lxd-dev from a Test Observer checkout.")
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    with (STATE_DIR / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if command == "up":
            previous_state = read_state()
            try:
                up(snapshot_arg)
            except subprocess.CalledProcessError as error:
                state = read_state()
                if state and state.get("startup_attempt") != previous_state.get("startup_attempt"):
                    try:
                        stop(state)
                    except Exception as cleanup_error:
                        progress(f"Cleanup after failed startup also failed: {cleanup_error}")
                command = shlex.join(error.cmd) if isinstance(error.cmd, list) else str(error.cmd)
                fail(
                    f"Command failed with exit code {error.returncode}: {command}\n"
                    f"Inspect the command output and, if relevant, {STATE_DIR / 'api.log'}."
                )
            except BaseException:
                state = read_state()
                if state and state.get("startup_attempt") != previous_state.get("startup_attempt"):
                    try:
                        stop(state)
                    except Exception as cleanup_error:
                        progress(f"Cleanup after failed startup also failed: {cleanup_error}")
                raise
        else:
            down()


if __name__ == "__main__":
    main(sys.argv[1:])
